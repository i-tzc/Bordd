#!/bin/bash
# ============================================================
#  Bordd.app 的可执行入口
#
#  由访达（Finder）双击 .app 时，macOS 直接运行本文件，
#  **不会弹出终端窗口** —— 这正是与 Windows 版双击 Bordd_gui.exe
#  完全一致的体验。
#
#  逻辑：
#    1. 运行环境已就绪  -> 直接静默启动图形界面
#    2. 首次运行        -> 弹窗说明，然后开一个终端窗口显示安装进度
# ============================================================

set -u

_HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$_HERE/../Resources/lib.sh"

# ---------- 情况一：已经装好，直接开界面（无终端窗口）----------
if runtime_ready; then
    exec "$VENV/bin/python" "$APP_SRC/bordd_gui.py"
fi

# ---------- 情况二：在终端里被手动调用，就地安装 ----------
if [ -t 1 ] && [ -t 0 ]; then
    exec /bin/bash "$RES/setup.sh"
fi

# ---------- 情况三：首次双击运行 ----------
if ! PY="$(find_python)"; then
    dialog "没有找到 Python 3.10 或更高版本。点「好」后会打开下载页面，装好 Python 之后再双击一次 Bordd 即可。"
    open_python_download
    exit 1
fi

dialog "这是 Bordd 的第一次运行，需要联网安装必需组件（大约 1~3 分钟）。点「好」之后会打开一个终端窗口显示安装进度，装好会自动打开 Bordd 主界面。"

# 用终端打开安装脚本，让用户能看到下载进度
open -a Terminal "$RES/setup.sh" >/dev/null 2>&1 || {
    # 极少数情况下 open -a Terminal 不可用，退回直接安装
    exec /bin/bash "$RES/setup.sh"
}
exit 0
